# InsureIntel Zimbabwe — Environment Configuration
# Copy this file to .env and fill in values before running the app.

APP_NAME=Insurance Documents Intelligence Platform
ENV=dev

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended for all environments):
DATABASE_URL=postgresql://insureuser:secret@localhost:5432/insuredb
#
# SQLite (lightweight fallback for offline development only):
# DATABASE_URL=sqlite:///./app.db
#
# Connection pool (PostgreSQL only — ignored for SQLite):
# DB_POOL_SIZE=5          # Persistent connections kept open
# DB_MAX_OVERFLOW=10      # Extra connections allowed under burst load
# DB_POOL_TIMEOUT=30      # Seconds to wait for a connection before error
# DB_POOL_RECYCLE=1800    # Drop idle connections after 30 minutes

LOG_LEVEL=INFO
API_BASE=http://127.0.0.1:8000

# ── JWT Security ──────────────────────────────────────────────────────────────
# For production, generate with: openssl rand -hex 32
SECRET_KEY=insure-intel-dev-only-secret-key-do-not-use-in-production-minimum64chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookie security (auto-set to true in production if not specified) ─────────
# COOKIE_SECURE=false

# ── Rate limits (slowapi format: "N/period") ──────────────────────────────────
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_REGISTER=10/minute

# ── Per-account brute-force lockout ──────────────────────────────────────────
# AUTH_LOCKOUT_MAX_FAILURES=10
# AUTH_LOCKOUT_WINDOW_SECONDS=900

# ── JWT blacklist cache ───────────────────────────────────────────────────────
# JTI_BLACKLIST_CACHE_TTL_SECONDS=60

# ── Trusted reverse-proxy IPs for X-Forwarded-For (comma-separated) ──────────
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# ── Storage paths (relative to project root) ──────────────────────────────────
MODEL_STORAGE_DIR=app/storage/models
DEMO_DATASET_DIR=storage/datasets/demo
APP_DATASET_DIR=storage/datasets/app
DEMO_MODEL_DIR=storage/models/demo
APP_MODEL_DIR=storage/models/app
KB_ROOT=sources/kb
SHOW_PLACEHOLDER_CONTROLS=false

# Production must run Alembic migrations explicitly before startup.
# Leave true only for local development/test databases.
AUTO_CREATE_SCHEMA=true

# ── Document processing ───────────────────────────────────────────────────────
# MAX_DOCUMENT_SIZE_MB=50   # Reject uploads larger than this (0 = no limit)

# ── Async job queue ───────────────────────────────────────────────────────────
# QUEUE_BACKEND=sqlite      # "sqlite" (no Redis required) | "arq" (Redis-backed)
# REDIS_URL=redis://localhost:6379/0   # Only used when QUEUE_BACKEND=arq

# ── Worker concurrency ────────────────────────────────────────────────────────
# OCR_WORKER_COUNT=2
# INGESTION_WORKER_COUNT=4
# EMBEDDING_WORKER_COUNT=1

# ── Worker memory limits (MB; 0 = disabled) ───────────────────────────────────
# OCR_WORKER_MAX_RSS_MB=800
# INGESTION_WORKER_MAX_RSS_MB=600
# EMBEDDING_WORKER_MAX_RSS_MB=0

# ── Job retry policy ──────────────────────────────────────────────────────────
# JOB_MAX_ATTEMPTS=3
# JOB_RETRY_BACKOFF_BASE_SECONDS=15
# JOB_RETRY_BACKOFF_MAX_SECONDS=1800
# JOB_TIMEOUT_SECONDS=300
# STUCK_JOB_TIMEOUT_MULTIPLIER=2
# STUCK_JOB_RECLAIM_INTERVAL_SECONDS=60

# ── Embedding model ───────────────────────────────────────────────────────────
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_VERSION=v1

# ── RAG chunking ──────────────────────────────────────────────────────────────
# RAG_CHUNK_SIZE=400
# RAG_CHUNK_OVERLAP=80

# ── RAG governance ────────────────────────────────────────────────────────────
# RAG_MIN_CONFIDENCE=0.30
# RAG_TOP_K=5

# ── LLM (chatbot uses offline engine; leave empty unless integrating Anthropic) ──
# ANTHROPIC_API_KEY=
